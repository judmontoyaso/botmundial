[Unit]
Description=ProMundial API (FastAPI + Uvicorn)
After=network.target
Wants=network.target

[Service]
Type=simple
User=promundial
Group=promundial
WorkingDirectory=/opt/botmundial/backend
ExecStart=/opt/botmundial/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=promundial-api

# Load .env variables
EnvironmentFile=/opt/botmundial/backend/.env

[Install]
WantedBy=multi-user.target
